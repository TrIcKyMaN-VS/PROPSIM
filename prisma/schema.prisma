generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  plan                String               @default("FREE")
  role                String               @default("USER")
  lastLogin           DateTime?
  routineConfig       String?
  notes               String?
  status              String               @default("ACTIVE")
  accounts            Account[]
  apiTokens           ApiToken[]
  adminActions        AuditLog[]           @relation("AdminAuditLogs")
  auditLogs           AuditLog[]           @relation("UserAuditLogs")
  brokerConnections   BrokerConnection[]
  challenges          ChallengeAccount[]
  challengeTemplates  ChallengeTemplate[]
  checklistTemplates  ChecklistTemplate[]
  dailyPerformances   DailyPerformance[]
  deviceSessions      DeviceSession[]
  importLogs          ImportLog[]
  passwordResetTokens PasswordResetToken[]
  playbooks           Playbook[]
  ruleTemplates       RuleTemplate[]
  ruleViolations      RuleViolation[]
  sessions            Session[]
  aiSettings          UserAiSettings?
  aiReviews           AiReview[]
  dailyJournals       DailyJournal[]
  weeklyReviews       WeeklyReview[]
  monthlyRecaps       MonthlyRecap[]
}

model DeviceSession {
  id        String   @id @default(cuid())
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  isValid   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  provider  String
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ChallengeType {
  OFFICIAL
  CUSTOM
}

model ChallengeAccount {
  id                String          @id @default(cuid())
  userId            String
  firmId            String
  sizeLabel         String
  rules             String
  challengeType     ChallengeType   @default(OFFICIAL)
  customOverrides   String?
  baseRules         String?
  status            String          @default("active")
  failReason        String?
  failureAt         DateTime?
  failureSnapshot   String?
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  brokerAccountName String?
  name              String?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleViolations    RuleViolation[]
  trades            Trade[]
}

model DiscoveredAccount {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  accountName String
  lastSeen    DateTime @default(now())

  @@unique([userId, provider, accountName])
}

model ChallengeTemplate {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  balance        Float
  profitTarget   Float
  dailyLoss      Float
  maxDrawdown    Float
  drawdownType   String
  consistencyPct Float    @default(0)
  maxContracts   Int
  minTradingDays Int
  maxTradingDays Int?
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Playbook {
  id              String    @id @default(cuid())
  userId          String
  name            String
  category        String
  marketCondition String
  session         String
  instrument      String
  entryRules      String
  exitRules       String
  riskRules       String
  checklist       String
  isPublic        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades          Trade[]
}

model ChecklistTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  items     String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id                String            @id @default(cuid())
  accountId         String
  playbookId        String?
  instrument        String
  direction         String
  entry             Float
  exit              Float
  contracts         Float
  pnl               Float
  day               Int
  timestamp         BigInt
  exitTime          BigInt?
  session           String
  notes             String?
  tags              String?
  confidenceScore   Float?
  isReconstructed   Boolean           @default(false)
  playbookChecklist String?
  calculatedPnl     Float?
  pnlMode           String            @default("AUTO")
  expectedRR        String?
  lessonsLearned    String?
  marketBias        String?
  mistakes          String?
  executionImprovement String?
  outcome           String?
  playbookName      String?
  psychologyNotes   String?
  reasonForEntry    String?
  tradeIdea         String?
  resultVsExpectation String?
  stopLoss          Float?
  adverseExcursion  Float?
  favorableExcursion Float?
  timingIncomplete  Boolean           @default(false)
  setupQualityScore  Float?
  entryQualityScore  Float?
  exitQualityScore   Float?
  riskScore          Float?
  disciplineScore    Float?
  lesson            LessonLearned?
  account           ChallengeAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  playbook          Playbook?         @relation(fields: [playbookId], references: [id])
  psychology        TradePsychology?
  screenshots       TradeScreenshot[]
}

model TradePsychology {
  id              String   @id @default(cuid())
  tradeId         String   @unique
  preFeeling      String?
  preNotes        String?
  checklistScore  Int?
  convictionScore Int?
  riskAmount      Float?
  rewardAmount    Float?
  expectedValue   Float?
  hesitated       Boolean  @default(false)
  movedStop       Boolean  @default(false)
  movedTarget     Boolean  @default(false)
  addedSize       Boolean  @default(false)
  emotionAffected Boolean  @default(false)
  brokeRules      Boolean  @default(false)
  exitReason      String?
  executionGrade  String?
  psychologyGrade String?
  riskGrade       String?
  complianceGrade String?
  decisionScore   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  trade           Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model TradeScreenshot {
  id        String   @id @default(cuid())
  tradeId   String
  stage     String
  url       String
  createdAt DateTime @default(now())
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model LessonLearned {
  id             String   @id @default(cuid())
  tradeId        String   @unique
  wentWell       String?
  wentWrong      String?
  biggestMistake String?
  improvement    String?
  createdAt      DateTime @default(now())
  trade          Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model DailyPerformance {
  id               String   @id @default(cuid())
  userId           String
  date             String
  sleepHours       Float?
  exercise         Boolean  @default(false)
  meditation       Boolean  @default(false)
  waterIntake      Int?
  mood             String?
  morningChecklist String?
  eodChecklist     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model RuleTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  nodes       String
  edges       String
  isPublic    Boolean  @default(false)
  isOfficial  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RuleViolation {
  id            String           @id @default(cuid())
  userId        String
  accountId     String
  tradeId       String?
  ruleName      String
  violationText String
  severity      String           @default("HARD")
  allowedValue  Float?
  actualValue   Float?
  violationHash String?
  isResolved    Boolean          @default(false)
  resolvedAt    DateTime?
  timestamp     DateTime?        @default(now())
  account       ChallengeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, violationHash])
}

model BrokerConnection {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accountName  String?
  status       String
  lastSync     DateTime?
  config       String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImportLog {
  id                String   @id @default(cuid())
  userId            String
  source            String
  newTradesCount    Int      @default(0)
  duplicatesSkipped Int      @default(0)
  errorsCount       Int      @default(0)
  status            String
  message           String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAiSettings {
  id            String    @id @default(cuid())
  userId        String    @unique
  provider      String    @default("PROPSIM")
  openaiKey     String?
  anthropicKey  String?
  geminiKey     String?
  totalRequests Int       @default(0)
  totalTokens   Int       @default(0)
  estimatedCost Float     @default(0)
  lastUsage     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  targetId  String?
  action    String
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  target    User?    @relation("AdminAuditLogs", fields: [targetId], references: [id])
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiReview {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "DAILY", "WEEKLY", "MONTHLY"
  dateKey   String   // e.g. "2026-06-09" or "2026-W23" or "2026-06"
  summary   String
  source    String   @default("PROGRAMMATIC")
  score1    Int?     // e.g. execution score
  score2    Int?     // e.g. psychology score
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dateKey])
}

model NewsEvent {
  id        String   @id @default(cuid())
  title     String
  timestamp DateTime
  impact    String   // "HIGH", "MEDIUM", "LOW"
  createdAt DateTime @default(now())
}


model WeeklyReview {
  id                      String   @id @default(cuid())
  userId                  String
  weekOf                  String
  daysTradedCount         Int?
  netR                    String?

  // 1. Patterns
  repeatedMistakes        String?
  repeatedWinConditions   String?
  emotionalTimingPatterns String?

  // 2. Rules Built (JSON: [{ when, then, from }])
  rulesBuilt              String?

  // 3. Backtest
  backtestTradesTaken     Int?
  backtestTradesSkipped   Int?
  backtestWinRate         String?
  backtestNetR            String?
  backtestLargestLoss     String?
  backtestNotes           String?

  // 4. Comparison
  actualNetR              String?
  ruleBasedNetR           String?
  comparisonDifference    String?
  whatDifferenceTellsMe   String?
  ruleSavedMost           String?
  ruleFilteredGoodTrade   String?

  // 5. Commitment
  oneRuleNotBreak         String?
  ruleStatusUpdates       String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekOf])
}

model MonthlyRecap {
  id                           String   @id @default(cuid())
  userId                       String
  month                        String
  daysTradedCount              Int?
  netR                         String?

  // Winning Trades
  winsImpactfulSetups          String?
  winsMaximisedDays            String?
  winsBestTradesCommon         String?
  winsAffectedConfidence       String?

  // Losing Trades
  lossesWithinRisk             String?
  lossesFollowedRules          String?
  lossesPatterns               String?
  lossesLearnedOrRepeated      String?

  // Overall
  overallDisciplineImproved    String?
  overallFollowedRulesMore     String?
  overallConsistentJournaling  String?
  overallCommitNextMonth       String?

  // Month vs Month
  monthVsMonthRepeatedMistakes  String?
  monthVsMonthCommitmentsKept   String?
  monthVsMonthHighestLeverage   String?

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}
model DailyJournal {
  id                  String   @id @default(cuid())
  userId              String
  date                String
  session             String   @default("NY")
  instrument          String?

  // Pre-Market Plan
  preMarketScreenshots String[] @default([])
  htfContext          String?
  keyLevels           String?
  scenarioA           String?
  scenarioB           String?
  newsEventRisk       String?
  riskPerTrade        String?
  maxTrades           Int?
  maxDailyLoss        String?
  stateCheck          Int?
  stateCheckNotes     String?

  // Red-Day Checklist
  isRedDay            Boolean  @default(false)
  redQ1LosingMore     String?
  redQ2FollowedModel  String?
  redQ3BlameRisk      String?
  redQ4SleepCalm      String?
  redVerdict          String?
  redCorrectiveAction String?

  // Post-Session Notes
  postSessionScreenshots String[] @default([])
  planAccuracy        Int?
  planAccuracyWhy     String?
  planAdherence       Int?
  planAdherenceWhy    String?
  overallThoughtProcess String?
  tomorrowAdd         String?
  tomorrowRemove      String?
  tomorrowConsider    String?
  netR                String?
  rulesBroken         String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
